---
import { Icon } from "astro-icon/components";
---

<button
  id="theme-toggle"
  aria-label="Toggle theme"
  data-tooltip="Toggle theme"
  class="cursor-pointer rounded-md p-2 text-sm font-medium text-[#5f6368] transition-all duration-200 hover:scale-105 hover:bg-[#e8f0fe]/70 hover:text-[#1a73e8] active:scale-95 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-blue-400"
>
  <span id="theme-toggle-light-icon" class="hidden">
    <Icon name="lucide:sun" class="h-5 w-5" />
  </span>

  <span id="theme-toggle-dark-icon" class="hidden">
    <Icon name="lucide:moon" class="h-5 w-5" />
  </span>
</button>

<script is:inline>
  function setupThemeToggle() {
    const darkIcon = document.getElementById("theme-toggle-dark-icon");
    const lightIcon = document.getElementById("theme-toggle-light-icon");
    const toggleBtn = document.getElementById("theme-toggle");

    if (!darkIcon || !lightIcon || !toggleBtn) return;

    if (document.documentElement.classList.contains("dark")) {
      lightIcon.classList.remove("hidden");
      darkIcon.classList.add("hidden");
    } else {
      darkIcon.classList.remove("hidden");
      lightIcon.classList.add("hidden");
    }

    toggleBtn.onclick = () => {
      document.documentElement.classList.add("theme-transition");
      window.requestAnimationFrame(() => {
        const isDark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");

        if (isDark) {
          lightIcon.classList.remove("hidden");
          darkIcon.classList.add("hidden");
        } else {
          darkIcon.classList.remove("hidden");
          lightIcon.classList.add("hidden");
        }

        document.dispatchEvent(
          new CustomEvent("theme-changed", { detail: { isDark } }),
        );

        window.setTimeout(() => {
          document.documentElement.classList.remove("theme-transition");
        }, 200);
      });
    };
  }

  setupThemeToggle();
  document.addEventListener("astro:after-swap", setupThemeToggle);
</script>
