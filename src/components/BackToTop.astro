---
import { Icon } from "astro-icon/components";
---

<button
  id="back-to-top"
  aria-label="Back to top"
  data-tooltip="Back to top"
  class="pointer-events-none fixed right-6 bottom-6 z-50 translate-y-4 cursor-pointer rounded-full border border-zinc-200 bg-white/80 p-3 text-zinc-700 opacity-0 shadow-lg backdrop-blur-md transition-all duration-300 hover:scale-110 focus:outline-none active:scale-95 dark:border-zinc-700 dark:bg-zinc-800/80 dark:text-zinc-200"
>
  <Icon name="lucide:arrow-up" class="h-5 w-5" />
</button>

<script>
  const VISIBLE_CLASSES = [
    "opacity-100",
    "pointer-events-auto",
    "translate-y-0",
  ];
  const HIDDEN_CLASSES = ["opacity-0", "pointer-events-none", "translate-y-4"];
  const updateVisibility = () => {
    const btn = document.getElementById("back-to-top");
    if (!btn) return;
    const show = window.scrollY > 300;
    btn.classList.remove(...(show ? HIDDEN_CLASSES : VISIBLE_CLASSES));
    btn.classList.add(...(show ? VISIBLE_CLASSES : HIDDEN_CLASSES));
  };

  const handleClick = (event: MouseEvent) => {
    if (!(event.target instanceof Element)) return;

    const btn = event.target.closest("#back-to-top");
    if (!btn) return;

    window.scrollTo({
      top: 0,
      behavior: "smooth",
    });

    btn.dispatchEvent(new MouseEvent("mouseout", { bubbles: true }));
  };

  window.addEventListener("scroll", updateVisibility, { passive: true });
  document.addEventListener("click", handleClick);
  document.addEventListener("astro:page-load", updateVisibility);
  updateVisibility();
</script>
