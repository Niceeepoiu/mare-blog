---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import { getTagHref } from "../utils/tags";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
---

<article
  class="flex items-stretch gap-4 rounded-lg bg-white p-5 shadow-sm dark:bg-gray-900"
>
  <div class="mt-2.5 ml-2.5 flex min-w-0 flex-1 flex-col">
    <h2 class="text-xl font-bold text-gray-800 dark:text-gray-100">
      {post.data.title}
    </h2>

    {
      post.data.description && (
        <p class="mt-2 line-clamp-2 text-sm text-gray-600 dark:text-gray-400">
          {post.data.description}
        </p>
      )
    }

    <div class="pt-4 text-xs font-medium text-gray-400 dark:text-gray-500">
      <time datetime={post.data.pubDate.toISOString()}>
        {
          post.data.pubDate.toLocaleString("en-US", {
            year: "numeric",
            month: "short",
            day: "numeric",
            hour: "2-digit",
            minute: "2-digit",
            hour12: false,
          })
        }
      </time>
    </div>

    {
      post.data.tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2" aria-label="Article tags">
          {post.data.tags.map((tag: string) => (
            <li>
              <a
                href={getTagHref(tag)}
                class="nav-scale-bg inline-flex rounded-md px-2.5 py-1.5 text-xs font-medium text-gray-600 no-underline transition-colors duration-200 hover:text-blue-600 hover:before:bg-blue-50/70 dark:text-gray-400 dark:hover:text-blue-400 dark:hover:before:bg-gray-800"
              >
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <a
    href={`/blog/${post.id}`}
    aria-label={`Read article: ${post.data.title}`}
    class="inline-flex shrink-0 items-center justify-center rounded-md border border-gray-200 pt-5 pr-1.5 pb-5 pl-1.5 text-gray-600 transition hover:bg-gray-100 active:scale-98 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
  >
    <Icon name="lucide:chevron-right" class="h-6.5 w-6.5" />
  </a>
</article>
