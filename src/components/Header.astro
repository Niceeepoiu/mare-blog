---
import siteConfig from "@config";
import ThemeToggle from "./ThemeToggle.astro";
import RssButton from "./RssButton.astro";
import Search from "./Search.astro";
import { Icon } from "astro-icon/components";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header
  class="mx-auto my-8 flex max-w-5xl items-center justify-between rounded-lg bg-white px-6 py-4 shadow-sm dark:bg-gray-900"
>
  <a
    href="/"
    class="text-xl font-bold tracking-tight text-[#1f2937] dark:text-gray-100"
  >
    {siteConfig.title}
  </a>

  <nav class="flex items-center gap-2">
    {
      siteConfig.nav.map((item) => {
        const normalizedHref = item.href.replace(/\/$/, "") || "/";

        const isActive =
          normalizedHref === "/"
            ? currentPath === "/"
            : currentPath === normalizedHref ||
              currentPath.startsWith(`${normalizedHref}/`);

        return (
          <a
            href={item.href}
            aria-label={item.name}
            class={`inline-flex items-center gap-1.5 rounded-md px-3 py-2 text-sm font-medium transition-all duration-200 ${
              isActive
                ? "bg-[#e8f0fe] font-semibold text-[#1a73e8] dark:bg-blue-950/60 dark:text-blue-400"
                : "text-[#5f6368] hover:scale-105 hover:bg-[#e8f0fe]/70 hover:text-[#1a73e8] active:scale-95 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-blue-400"
            }`}
          >
            {item.icon && <Icon name={item.icon} class="h-4 w-4" />}

            <span class="hidden md:inline">{item.name}</span>
          </a>
        );
      })
    }
  </nav>

  <div class="flex items-center gap-1">
    <Search />
    <RssButton />
    <ThemeToggle />
  </div>
</header>
