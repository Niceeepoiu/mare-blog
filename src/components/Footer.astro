---
import siteConfig from "@config";
const currentYear = new Date().getFullYear();
---

<footer class="mx-auto mb-10 max-w-5xl">
  <div
    class="flex items-center justify-center rounded-lg bg-white px-8 py-6 shadow-lg"
  >
    <p class="text-center text-[#5f6368]">
      © {currentYear}&nbsp;
      <a
        href={siteConfig.AuthorUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold text-[#1f2937] transition-colors duration-200 hover:text-[#1a73e8]"
      >
        {siteConfig.Author}
      </a>
      . All rights reserved.
    </p>
  </div>
</footer>
