---
import { Icon } from "astro-icon/components";

const isDev = import.meta.env.DEV;
---

<button
  id="search-toggle"
  type="button"
  aria-label="Search"
  data-tooltip="Search"
  class="cursor-pointer rounded-md p-2 text-sm font-medium text-[#5f6368] transition-all duration-200 hover:scale-105 hover:bg-[#e8f0fe]/70 hover:text-[#1a73e8] active:scale-95 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-blue-400"
>
  <Icon name="lucide:search" class="h-5 w-5" />
</button>

{
  !isDev && (
    <>
      <pagefind-modal-trigger
        instance="site-search"
        compact
        data-tooltip="Search"
        id="pagefind-search-trigger"
        hidden
      />
      <pagefind-modal instance="site-search" />
    </>
  )
}

{
  isDev && (
    <dialog
      id="search-dev-dialog"
      aria-labelledby="search-dev-title"
      class="m-auto max-h-[min(80dvh,800px)] w-full max-w-140 overflow-hidden rounded-xl border-0 bg-white p-0 shadow-2xl backdrop:bg-black/50 dark:bg-[#1a1a1a]"
    >
      <div class="flex items-center gap-2 border-b border-gray-200 px-4 py-4 dark:border-[#333]">
        <Icon name="lucide:search" class="h-4 w-4 shrink-0 text-gray-500" />
        <h2
          id="search-dev-title"
          class="m-0 min-w-0 flex-1 truncate text-base leading-5 font-normal tracking-normal text-gray-500 dark:text-gray-400"
        >
          Search
        </h2>
        <form method="dialog">
          <button
            type="submit"
            aria-label="Close search"
            class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-900 focus:outline-2 focus:outline-offset-2 focus:outline-[#1a73e8] dark:text-gray-400 dark:hover:bg-[#252525] dark:hover:text-gray-100"
          >
            <Icon name="lucide:x" class="h-5 w-5" />
          </button>
        </form>
      </div>

      <div class="px-4 py-8 text-center">
        <Icon name="lucide:info" class="mx-auto mb-3 h-5 w-5 text-gray-500" />
        <p class="mb-1 text-sm font-medium text-gray-700 dark:text-gray-200">
          Search is unavailable in development
        </p>
        <p class="text-xs text-gray-500 dark:text-gray-400">
          Build the site and use preview mode to test Pagefind search.
        </p>
      </div>

      <div class="border-t border-gray-200 px-4 py-2.5 text-xs text-gray-500 dark:border-[#333] dark:text-gray-400">
        Press
        <kbd class="mx-1 rounded border border-gray-300 px-1.5 py-0.5 text-[10px] dark:border-gray-600">
          Esc
        </kbd>
        to close
      </div>
    </dialog>
  )
}

<script>
  import "@pagefind/component-ui";
</script>

<style is:global>
  @import "@pagefind/component-ui/css";

  @media (prefers-reduced-motion: no-preference) {
    #search-dev-dialog[open] {
      animation: search-dev-dialog-appear 0.15s ease-out;
    }

    @keyframes search-dev-dialog-appear {
      from {
        opacity: 0;
        transform: scale(0.95);
      }

      to {
        opacity: 1;
        transform: scale(1);
      }
    }
  }
</style>

<script is:inline>
  function setupSearchToggle() {
    const searchButton = document.getElementById("search-toggle");
    const pagefindTrigger = document.getElementById("pagefind-search-trigger");
    const devDialog = document.getElementById("search-dev-dialog");

    if (!searchButton) return;

    if (devDialog instanceof HTMLDialogElement) {
      devDialog.onclick = (event) => {
        if (event.target === devDialog) devDialog.close();
      };
    }

    searchButton.onclick = () => {
      if (devDialog instanceof HTMLDialogElement) {
        if (!devDialog.open) devDialog.showModal();
        return;
      }

      if (!pagefindTrigger) return;
      const triggerButton = pagefindTrigger.querySelector("button");
      triggerButton?.click();
    };
  }

  setupSearchToggle();
  document.addEventListener("astro:page-load", setupSearchToggle);
</script>
