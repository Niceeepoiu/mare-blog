---
import { Icon } from "astro-icon/components";
---

<a
  href="/rss.xml"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="RSS Feed"
  data-tooltip="Subscribe to RSS Feed"
  class:list={[
    "nav-scale-bg inline-flex items-center justify-center rounded-md p-2 text-sm font-medium text-[#5f6368] transition-colors duration-200 hover:text-[#1a73e8] hover:before:bg-[#e8f0fe]/70 dark:text-gray-400 dark:hover:text-blue-400 dark:hover:before:bg-gray-800",
  ]}
>
  <Icon name="lucide:rss" class="h-5 w-5" />
</a>
