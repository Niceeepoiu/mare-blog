---
import siteConfig from "@config";
import "nprogress/nprogress.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Comment from "../components/Comments.astro";
import GlobalTooltip from "../components/GlobalTooltip.astro";
import BackToTop from "../components/BackToTop.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  pageTitle: string;
  description?: string;
  showComments?: boolean;
}

const { pageTitle, description, showComments = false } = Astro.props;

const metaDescription = description ?? siteConfig.description;
const lang = siteConfig.lang ?? "en";
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={metaDescription} />
    <title>{pageTitle} - {siteConfig.title}</title>
    <ClientRouter />

    <script is:inline>
      const applyTheme = () => {
        const theme = (() => {
          if (
            typeof localStorage !== "undefined" &&
            localStorage.getItem("theme")
          ) {
            return localStorage.getItem("theme");
          }
          if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
            return "dark";
          }
          return "light";
        })();
        if (theme === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      };

      applyTheme();
      document.addEventListener("astro:after-swap", applyTheme);
    </script>

    <script>
      import NProgress from "nprogress";
      NProgress.configure({ showSpinner: false, speed: 400 });
      document.addEventListener("astro:before-preparation", () => {
        NProgress.start();
      });
      document.addEventListener("astro:page-load", () => {
        NProgress.done();
      });
    </script>
  </head>
  <body>
    <Header transition:persist />

    <main class="mx-auto my-8 max-w-5xl" data-pagefind-body>
      <header class="mb-8 rounded-lg bg-white p-10 shadow-sm dark:bg-gray-900">
        {
          Astro.slots.has("page-header-prefix") && (
            <slot name="page-header-prefix" />
          )
        }
        <h1 class="my-0">{pageTitle}</h1>
        {
          description && (
            <p class="mt-3 text-base leading-relaxed text-gray-600 dark:text-gray-400">
              {description}
            </p>
          )
        }
        {
          Astro.slots.has("page-header-details") && (
            <div class={description ? "mt-4" : "mt-3"}>
              <slot name="page-header-details" />
            </div>
          )
        }
      </header>
      <slot />
    </main>
    {
      showComments && siteConfig.giscus.enabled && (
        <section class="mx-auto my-8 max-w-5xl">
          <Comment />
        </section>
      )
    }
    <BackToTop />
    <Footer transition:persist />
    <GlobalTooltip />
  </body>
</html>
