---
import siteConfig from "@config";
import "nprogress/nprogress.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Comment from "../components/Comments.astro";
import GlobalTooltip from "../components/GlobalTooltip.astro";
import BackToTop from "../components/BackToTop.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  pageTitle: string;
  showComments?: boolean;
}

const { pageTitle, showComments = false } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={siteConfig.description} />
    <title>{pageTitle} - {siteConfig.title}</title>
    <ClientRouter />

    <script is:inline>
      const applyTheme = () => {
        const theme = (() => {
          if (
            typeof localStorage !== "undefined" &&
            localStorage.getItem("theme")
          ) {
            return localStorage.getItem("theme");
          }
          if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
            return "dark";
          }
          return "light";
        })();
        if (theme === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      };
      applyTheme();
      document.addEventListener("astro:after-swap", applyTheme);
    </script>

    <script>
      import NProgress from "nprogress";
      NProgress.configure({ showSpinner: false, speed: 400 });
      document.addEventListener("astro:before-preparation", () => {
        NProgress.start();
      });
      document.addEventListener("astro:page-load", () => {
        NProgress.done();
      });
    </script>
  </head>
  <body>
    <Header transition:persist />

    <main
      class="mx-auto my-8 max-w-5xl rounded-lg bg-white p-5 shadow-sm sm:p-8 lg:p-12 dark:bg-gray-900"
      data-pagefind-body
    >
      <slot />
    </main>

    {
      showComments && (
        <section class="mx-auto my-8 max-w-5xl">
          <Comment />
        </section>
      )
    }

    <BackToTop />
    <Footer transition:persist />
    <GlobalTooltip />
  </body>
</html>
