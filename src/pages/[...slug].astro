---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const pages = await getCollection("page");

  return pages.map((page) => ({
    params: { slug: page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<BaseLayout pageTitle={page.data.title} showMainCard={false}>
  <header
    class="mb-8 rounded-lg bg-white p-5 shadow-sm sm:p-8 lg:p-12 dark:bg-gray-900"
  >
    <h1>
      {page.data.title}
    </h1>

    {
      page.data.description && (
        <p class="mt-3 text-base leading-relaxed text-gray-600 dark:text-gray-400">
          {page.data.description}
        </p>
      )
    }
  </header>

  <article class="markdown-content rounded-lg bg-white p-5 shadow-sm sm:p-8 lg:p-12 dark:bg-gray-900">
    <Content />
  </article>
</BaseLayout>
