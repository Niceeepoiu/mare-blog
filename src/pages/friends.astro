---
import { getCollection, getEntry, render } from "astro:content";
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";

const friendsPage = await getEntry("page", "friends");

if (!friendsPage) {
  throw new Error("The Friends page content entry is missing.");
}

const { Content } = await render(friendsPage);
const friends = await getCollection("friend");
const orderedFriends = [...friends].sort((left, right) =>
  left.data.name.localeCompare(right.data.name),
);
---

<BaseLayout
  pageTitle={friendsPage.data.title}
  description={friendsPage.data.description ??
    "A curated list of blogs, projects, and communities I value."}
  showComments={true}
>
  <section
    class="rounded-xl bg-white px-5 py-5 shadow-sm sm:px-8 sm:py-7 dark:bg-gray-900"
  >
    <div class="markdown-content">
      <Content />
    </div>
  </section>
  {
    orderedFriends.length > 0 ? (
      <section aria-label="Friend links" class="mt-6">
        <div data-friend-grid class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {orderedFriends.map((friend) => (
            <a
              href={friend.data.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex h-full flex-col rounded-lg bg-white p-5 text-left no-underline shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md dark:bg-gray-900"
            >
              <div class="flex items-start gap-3">
                {friend.data.darkAvatar ? (
                  <>
                    <img
                      src={friend.data.avatar ?? "/favicon.svg"}
                      alt={`${friend.data.name} avatar`}
                      loading="lazy"
                      width="48"
                      height="48"
                      class="h-12 w-12 rounded-full object-cover dark:hidden"
                    />
                    <img
                      src={friend.data.darkAvatar}
                      alt=""
                      loading="lazy"
                      width="48"
                      height="48"
                      class="hidden h-12 w-12 rounded-full object-cover dark:block"
                    />
                  </>
                ) : (
                  <img
                    src={friend.data.avatar ?? "/favicon.svg"}
                    alt={`${friend.data.name} avatar`}
                    loading="lazy"
                    width="48"
                    height="48"
                    class="h-12 w-12 rounded-full object-cover"
                  />
                )}
                <div class="min-w-0">
                  <div class="flex items-center gap-2">
                    <span class="truncate text-base font-semibold text-gray-900 transition-colors group-hover:text-blue-600 dark:text-gray-100 dark:group-hover:text-blue-400">
                      {friend.data.name}
                    </span>
                    <Icon
                      name="lucide:arrow-up-right"
                      class="h-4 w-4 shrink-0 text-gray-400 transition-colors group-hover:text-blue-600 dark:text-gray-500 dark:group-hover:text-blue-400"
                    />
                  </div>
                  <span class="mt-1 block truncate text-xs text-gray-500 dark:text-gray-400">
                    {friend.data.url.replace(/^https?:\/\//, "")}
                  </span>
                </div>
              </div>
              <p class="mt-4 mb-0 flex-1 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
                {friend.data.description}
              </p>
            </a>
          ))}
        </div>
      </section>
    ) : (
      <section
        aria-label="Friend links"
        class="mt-6 rounded-lg bg-white p-6 text-center text-sm text-gray-500 shadow-sm dark:bg-gray-900 dark:text-gray-400"
      >
        No friends have been added yet. Leave a comment below to suggest a site.
      </section>
    )
  }
</BaseLayout>

<script>
  const shuffleFriendCards = () => {
    const grid = document.querySelector("[data-friend-grid]");
    if (!(grid instanceof HTMLElement)) return;

    const cards = Array.from(grid.children);
    for (let index = cards.length - 1; index > 0; index--) {
      const randomIndex = Math.floor(Math.random() * (index + 1));
      [cards[index], cards[randomIndex]] = [cards[randomIndex], cards[index]];
    }

    grid.replaceChildren(...cards);
  };

  shuffleFriendCards();
  document.addEventListener("astro:page-load", shuffleFriendCards);
</script>
