---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const entries = (await getCollection("journal")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const renderedEntries = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);
---

<BaseLayout
  pageTitle="Journal"
  description="Short notes and moments collected over time."
>
  <header class="mb-10 border-b border-gray-300 pb-6 dark:border-gray-700">
    <h1>Journal</h1>
    <p class="mt-3 text-base leading-relaxed text-gray-600 dark:text-gray-400">
      Short notes and moments, collected over time.
    </p>
  </header>

  {
    renderedEntries.length > 0 ? (
      <ol class="space-y-10">
        {renderedEntries.map(({ entry, Content }, index) => (
          <li class="grid grid-cols-[4.5rem_1rem_minmax(0,1fr)] items-stretch gap-x-2 sm:grid-cols-[7rem_1.5rem_minmax(0,1fr)] sm:gap-x-4">
            <time
              datetime={entry.data.pubDate.toISOString()}
              class="pt-1 text-right text-xs leading-5 text-gray-500 sm:text-sm dark:text-gray-400"
            >
              <span class="block">
                {entry.data.pubDate.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                  timeZone: "UTC",
                })}
              </span>
              <span class="block text-[11px] sm:text-xs">
                {entry.data.pubDate.toLocaleTimeString("en-US", {
                  hour: "numeric",
                  minute: "2-digit",
                  timeZone: "UTC",
                  timeZoneName: "short",
                })}
              </span>
            </time>

            <div class="relative flex justify-center">
              {index < renderedEntries.length - 1 && (
                <span
                  aria-hidden="true"
                  class="absolute top-3 -bottom-10 left-1/2 w-px -translate-x-1/2 bg-gray-300 dark:bg-gray-700"
                />
              )}
              <span class="relative z-10 mt-1 h-3 w-3 rounded-full border-[3px] border-[#1a73e8] bg-white dark:border-blue-400 dark:bg-gray-900" />
            </div>

            <article class="min-w-0 pb-1">
              <h2 class="mb-3 text-xl font-semibold text-gray-900 dark:text-gray-100">
                {entry.data.title}
              </h2>
              <div class="markdown-content">
                <Content />
              </div>
            </article>
          </li>
        ))}
      </ol>
    ) : (
      <p class="text-sm text-gray-500 dark:text-gray-400">
        No journal entries yet. Add a Markdown file in
        <code>src/content/journal/</code> to begin.
      </p>
    )
  }
</BaseLayout>
