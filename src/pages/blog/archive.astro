---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const groupedPosts = Object.groupBy(posts, (post) =>
  new Date(post.data.pubDate).getFullYear().toString(),
);

const archiveEntries = (
  Object.entries(groupedPosts) as [string, typeof posts][]
).sort(([yearA], [yearB]) => Number(yearB) - Number(yearA));
---

<BaseLayout pageTitle="Archive" description="Browse articles by timestamp">
  <div
    class="rounded-xl bg-white px-4 py-6 shadow-sm sm:px-8 sm:py-8 lg:px-10 dark:bg-gray-900"
  >
    {
      archiveEntries.length > 0 ? (
        <div class="flex flex-col gap-7 sm:gap-8">
          {archiveEntries.map(([year, yearPosts]) => (
            <section
              aria-labelledby={`archive-year-${year}`}
              class="relative before:absolute before:top-5.25 before:bottom-0 before:left-20 before:border-l before:border-gray-300 before:content-[''] sm:before:top-5.75 dark:before:border-gray-700"
            >
              <h2
                id={`archive-year-${year}`}
                class="relative grid grid-cols-[3.5rem_3rem_minmax(0,1fr)] items-center text-xl font-bold tracking-tight text-gray-800 sm:text-2xl dark:text-gray-100"
              >
                <span>{year}</span>
                <span class="flex justify-center">
                  <span class="relative z-10 h-3.5 w-3.5 rounded-full border-2 border-blue-500 bg-white dark:border-blue-400 dark:bg-gray-900" />
                </span>
                <span class="text-xs font-normal tracking-normal text-gray-500 sm:text-sm dark:text-gray-400">
                  {yearPosts.length} {yearPosts.length === 1 ? "post" : "posts"}
                </span>
              </h2>
              <ul class="relative mt-2 space-y-0.5">
                {yearPosts.map((post) => (
                  <li class="group relative grid grid-cols-[3.5rem_3rem_minmax(0,1fr)] items-center">
                    <a
                      href={`/blog/${post.id}`}
                      class="col-span-3 grid grid-cols-[3.5rem_3rem_minmax(0,1fr)] items-center rounded-md py-2 transition-colors duration-200 hover:bg-blue-50/70 focus-visible:bg-blue-50/70 focus-visible:outline-none dark:hover:bg-gray-800/70 dark:focus-visible:bg-gray-800/70"
                    >
                      <time
                        datetime={post.data.pubDate.toISOString()}
                        class="pr-1 text-right text-xs font-medium text-gray-500 sm:text-sm dark:text-gray-400"
                      >
                        {post.data.pubDate
                          .toLocaleDateString("en-US", {
                            month: "2-digit",
                            day: "2-digit",
                          })
                          .replace("/", "-")}
                      </time>
                      <span class="relative z-10 flex justify-center">
                        <span class="h-1 w-1 rounded-full bg-gray-400 transition-all duration-200 group-hover:h-5 group-hover:bg-blue-500 dark:bg-gray-500 dark:group-hover:bg-blue-400" />
                      </span>
                      <span class="block min-w-0 px-2">
                        <span class="block truncate text-sm font-semibold text-gray-800 transition-colors group-hover:text-blue-600 sm:text-base dark:text-gray-200 dark:group-hover:text-blue-400">
                          {post.data.title}
                        </span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      ) : (
        <div class="py-8 text-center">
          <p class="text-sm font-medium text-gray-500 dark:text-gray-400">
            No archives found.
          </p>
        </div>
      )
    }
  </div>
</BaseLayout>
