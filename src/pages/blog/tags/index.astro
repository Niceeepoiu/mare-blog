---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getTagHref, getTagSummaries } from "../../../utils/tags";

const tags = getTagSummaries(await getCollection("blog"));
---

<BaseLayout pageTitle="Tags" description="Browse articles by topic.">
  {
    tags.length > 0 ? (
      <ul class="flex flex-wrap gap-3">
        {tags.map((tag) => (
          <li>
            <a
              href={getTagHref(tag.name)}
              class="inline-flex items-center gap-2 rounded-md bg-white px-3 py-2 text-sm text-gray-700 shadow-sm transition-colors hover:text-blue-600 dark:bg-gray-900 dark:text-gray-300 dark:hover:text-blue-400"
            >
              <span>{tag.name}</span>
              <span class="rounded-full bg-gray-100 px-2 py-1 text-xs text-gray-400 dark:bg-amber-50/10 dark:text-gray-500">
                {tag.count}
              </span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-sm text-gray-500 dark:text-gray-400">
        No tags have been added yet.
      </p>
    )
  }
</BaseLayout>
