---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getTagHref } from "../../utils/tags";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

const post = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  pageTitle={post.data.title}
  description={post.data.description}
  showComments={true}
>
  <header class="mb-8 border-b border-gray-300 pb-6 dark:border-gray-700">
    <h1>
      {post.data.title}
    </h1>

    {
      post.data.description && (
        <p class="mt-3 text-base leading-relaxed text-gray-600 dark:text-gray-400">
          {post.data.description}
        </p>
      )
    }
    <div
      class="mt-4 flex items-center gap-4 text-sm text-gray-500 dark:text-gray-400"
    >
      <time datetime={post.data.pubDate.toISOString()}>
        {
          post.data.pubDate.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })
        }
      </time>
    </div>
    {
      post.data.tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2" aria-label="Article tags">
          {post.data.tags.map((tag: string) => (
            <li>
              <a
                href={getTagHref(tag)}
                class="inline-flex rounded-sm border border-gray-200 px-2 py-1 text-xs font-medium text-gray-600 transition-colors hover:border-[#1a73e8] hover:text-[#1a73e8] dark:border-gray-700 dark:text-gray-400 dark:hover:border-blue-500 dark:hover:text-blue-400"
              >
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </header>

  <article class="markdown-content">
    <Content />
  </article>
</BaseLayout>
