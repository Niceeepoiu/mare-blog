---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { getTagHref } from "../../utils/tags";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

const post = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  pageTitle={post.data.title}
  description={post.data.description}
  showComments={true}
>
  <div slot="page-header-details">
    <time
      datetime={post.data.pubDate.toISOString()}
      class="mr-auto flex inline-flex items-center gap-1 rounded-md bg-gray-50 p-2 text-sm font-medium text-gray-400 dark:bg-gray-800 dark:text-gray-500"
    >
      <Icon
        name="lucide:calendar"
        aria-hidden="true"
        class="mr-1 h-3.5 w-3.5 shrink-0"
      />
      <span>
        {
          post.data.pubDate.toLocaleString("en-US", {
            year: "numeric",
            month: "short",
            day: "numeric",
            hour: "2-digit",
            minute: "2-digit",
            hour12: false,
          })
        }
      </span>
    </time>
    {
      post.data.tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2" aria-label="Article tags">
          {post.data.tags.map((tag: string) => (
            <li>
              <a
                href={getTagHref(tag)}
                class="dark:hover:bg-blue-450 flex inline-flex items-center gap-1 rounded-md bg-blue-50/70 px-2.5 py-1.5 text-sm font-medium text-blue-600 no-underline transition-colors duration-200 hover:bg-blue-500 hover:text-white dark:bg-gray-800 dark:text-blue-400 dark:hover:text-gray-100"
              >
                <Icon
                  name="lucide:tag"
                  aria-hidden="true"
                  class="mr-1 h-3.5 w-3.5 shrink-0"
                />
                <span>{tag}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <article
    class="markdown-content rounded-lg bg-white p-5 shadow-sm sm:p-8 lg:p-12 dark:bg-gray-900"
  >
    <Content />
  </article>
</BaseLayout>
