---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import siteConfig from "@config";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";

const allPosts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const pageSize = siteConfig.postsPerPage ?? 6;
const totalPages = Math.max(1, Math.ceil(allPosts.length / pageSize));
const currentPage = 1;
const pageItems = allPosts.slice(0, pageSize);
const pageLinks = Array.from({ length: totalPages }, (_, index) => index + 1);
const pageTitle = "Blog";
---

<BaseLayout pageTitle={pageTitle}>
  <h1>Blog</h1>

  <div class="flex flex-col gap-6">
    {pageItems.map((post) => <PostCard post={post} />)}
  </div>

  <nav
    aria-label="Blog pagination"
    class="mt-8 flex flex-wrap items-center justify-center gap-3 text-sm"
  >
    <span
      data-tooltip="No previous page"
      class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-gray-200 bg-gray-100 text-gray-400 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-600"
      aria-label="Previous page"
    >
      <Icon name="lucide:chevron-left" class="h-4 w-4" />
    </span>

    {
      pageLinks.map((pageNumber) => {
        const href = pageNumber === 1 ? "/blog" : `/blog/${pageNumber}`;
        const isCurrent = currentPage === pageNumber;

        return (
          <a
            href={href}
            aria-current={isCurrent ? "page" : undefined}
            class={`flex h-10 w-10 items-center justify-center rounded-md border text-sm transition-colors ${
              isCurrent
                ? "border-[#1a73e8] bg-[#1a73e8] text-white"
                : "border-gray-200 bg-white text-gray-700 hover:border-[#1a73e8] hover:text-[#1a73e8] dark:border-gray-700 dark:bg-gray-900 dark:text-gray-200 dark:hover:border-blue-500 dark:hover:text-blue-400"
            }`}
          >
            {pageNumber}
          </a>
        );
      })
    }

    {
      totalPages > 1 ? (
        <a
          href="/blog/2"
          data-tooltip="Next page"
          aria-label="Next page"
          class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-gray-200 bg-white text-gray-700 transition-colors hover:border-[#1a73e8] hover:text-[#1a73e8] dark:border-gray-700 dark:bg-gray-900 dark:text-gray-200 dark:hover:border-blue-500 dark:hover:text-blue-400"
        >
          <Icon name="lucide:chevron-right" class="h-4 w-4" />
        </a>
      ) : (
        <span
          data-tooltip="No next page"
          class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-gray-200 bg-gray-100 text-gray-400 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-600"
          aria-label="Next page"
        >
          <Icon name="lucide:chevron-right" class="h-4 w-4" />
        </span>
      )
    }
  </nav>
</BaseLayout>
