---
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = "404 - Page Not Found";
---

<BaseLayout pageTitle={pageTitle}>
  <div
    class="rounded-lg bg-white p-5 text-center shadow-sm sm:p-8 lg:p-12 dark:bg-gray-900"
  >
    <p class="m-3.5 text-gray-600 dark:text-gray-400">
      Oops! The page you're looking for doesn't exist.
    </p>
    <a href="/" class="text-blue-500 hover:underline dark:text-blue-400"
      >Go back to Home</a
    >
  </div>
</BaseLayout>
