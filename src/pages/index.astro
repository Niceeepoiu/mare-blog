---
import siteConfig from "@config";
import { getCollection } from "astro:content";
import PostCard from "../components/PostCard.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = "Welcome to My Blog";
const featuredPosts = (await getCollection("blog"))
  .filter((post) => post.data.featured)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout pageTitle={pageTitle} description={siteConfig.description}>
  <section aria-labelledby="user-card-heading">
    <div class="flex items-center justify-between">
      <h2 id="user-card-heading" class="mb-6">About the author</h2>
      <a
        href="/about"
        class="mb-6 text-sm font-medium text-blue-500 hover:underline dark:text-blue-400"
      >
        More about me
      </a>
    </div>
    <section class="rounded-lg bg-white p-8 shadow-sm dark:bg-gray-900">
      <div class="flex items-center gap-5">
        <Image
          src={siteConfig.avatar}
          alt={siteConfig.author}
          width={104}
          height={104}
          class="h-25 w-25 shrink-0 rounded-full object-cover shadow-sm ring-4 ring-white dark:ring-gray-800"
        />
        <div class="min-w-0">
          <h2 class="m-0 text-2xl">{siteConfig.author}</h2>
          <p
            class="mt-1 mb-3 text-base leading-relaxed text-gray-600 dark:text-gray-400"
          >
            {siteConfig.authorBio}
          </p>
          <div class="flex flex-wrap items-center gap-2">
            <span class="m-2.5 inline-flex items-center gap-1.5 text-sm">
              <Icon name="lucide:map-pin" class="h-4 w-4" />
              {siteConfig.authorLocation}
            </span>
            {
              siteConfig.authorLinks?.map((link) => (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={link.name}
                  class="nav-scale-bg m-2.5 inline-flex items-center gap-1.5 rounded-md px-3 py-2 text-sm font-medium text-gray-600 no-underline transition-colors duration-200 hover:text-blue-600 hover:before:bg-blue-50/70 dark:text-gray-400 dark:hover:text-blue-400 dark:hover:before:bg-gray-800"
                >
                  {link.icon && <Icon name={link.icon} class="h-4 w-4" />}
                  <span>{link.name}</span>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </section>
  <section class="mt-8" aria-labelledby="featured-posts-heading">
    <div class="flex items-center justify-between">
      <h2 id="featured-posts-heading" class="mb-6">Featured posts</h2>
      <a
        href="/blog"
        class="mb-6 text-sm font-medium text-blue-500 hover:underline dark:text-blue-400"
      >
        View all posts
      </a>
    </div>
    {
      featuredPosts.length > 0 ? (
        <div class="flex flex-col gap-6">
          {featuredPosts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <p class="py-2 text-sm text-gray-500 dark:text-gray-400">
          No featured posts yet.
        </p>
      )
    }
  </section>
</BaseLayout>
